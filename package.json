{
  "name": "cheaty-flashcards",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "vue-tsc && vp build",
    "preview": "vp preview",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vp test",
    "check": "vp check",
    "deploy": "vp build && wrangler deploy",
    "generate:ziggy": "node scripts/generate-ziggy-assets.mjs",
    "optimize:ziggy": "node scripts/optimize-ziggy-assets.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@unhead/vue": "^3.3.1",
    "@vueuse/core": "^14.4.0",
    "canvas-confetti": "^1.9.4",
    "howler": "^2.2.4",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@google/genai": "^2.16.0",
    "@iconify-json/feather": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.41",
    "@vue/test-utils": "^2.4.11",
    "daisyui": "^5.7.16",
    "jsdom": "^30.0.1",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-icons": "^23.0.1",
    "vite": "catalog:",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.3.9",
    "wrangler": "^4.119.0"
  },
